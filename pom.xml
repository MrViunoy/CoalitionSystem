<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.coalitions</groupId>
    <artifactId>Coalitions</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <language>ru</language>
        <plugin.description>Система коалиций с префиксами в списке игроков, над головой и в чате</plugin.description>
        <plugin.command.description>Управление коалициями</plugin.command.description>
        <plugin.command.usage>/co &lt;create|setleader|delete|add|kick|color|prefix|info&gt;</plugin.command.usage>
        <plugin.permission.description>Доступ к командам администратора коалиций</plugin.permission.description>
    </properties>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- Paper API (Purpur є форком Paper, тому плагін працює і на ньому) -->
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>1.21.1-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>Coalitions-${project.version}-${language}</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <delimiters>
                    <delimiter>@</delimiter>
                </delimiters>
                <useDefaultDelimiters>false</useDefaultDelimiters>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>english</id>
            <properties>
                <language>en</language>
                <plugin.description>Coalition tags for chat, player list and overhead names</plugin.description>
                <plugin.command.description>Coalition management</plugin.command.description>
                <plugin.command.usage>/co &lt;create|setleader|delete|add|kick|color|prefix|info&gt;</plugin.command.usage>
                <plugin.permission.description>Access to coalition administrator commands</plugin.permission.description>
            </properties>
        </profile>
    </profiles>
</project>
